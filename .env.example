PORT=3000

# false (ou absent) = mode mémoire, utilisé par `npm run dev` et par la CI.
# true = mode PostgreSQL + Redis, utilisé automatiquement par `docker compose up`
# (ne pas passer USE_DATABASE=true ici sans lancer aussi les conteneurs db/cache).
USE_DATABASE=false
DATABASE_URL=postgres://user:pass@localhost:5432/electrobike
REDIS_URL=redis://localhost:6379
